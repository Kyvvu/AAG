{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from vocabulary.yaml — do not edit by hand (run: python spec/generate.py). SPDX-License-Identifier: CC-BY-4.0",
  "title": "AAG Action",
  "description": "A single Agent Action Grammar action (AAG 0.6.0).",
  "type": "object",
  "required": [
    "agent_id",
    "task_id",
    "timestamp",
    "step_name",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Stable identifier of the agent performing this action. A task may carry actions from several agents that share memory."
    },
    "task_id": {
      "type": "string",
      "description": "The logical task — one shared-memory scope. Unique per run; groups every action of the task."
    },
    "parent_task_id": {
      "type": "string",
      "description": "The task_id of the task that spawned this one."
    },
    "action_id": {
      "type": "string",
      "description": "Identifier of one action; emitted on an intended record and repeated on the record that settles it (completed or denied)."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Sequence number within the task. Absent for an intended action; assigned when recorded."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the harness emitted the action (ISO 8601)."
    },
    "step_name": {
      "type": "string",
      "description": "Human-readable label for the action."
    },
    "kind": {
      "type": "string",
      "enum": [
        "task.start",
        "task.end",
        "task.error",
        "task.idle",
        "step.resource",
        "step.message",
        "step.self",
        "step.model",
        "step.credential",
        "step.exec",
        "step.gate",
        "step.unknown"
      ],
      "description": "The action kind; one of `action_kinds`."
    },
    "verb": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
      ],
      "description": "GET / POST / PATCH / DELETE."
    },
    "aag_version": {
      "type": "string",
      "description": "The AAG version the stream conforms to."
    },
    "properties": {
      "type": "object",
      "description": "Nested contextual object (see `properties`). Open and extensible."
    },
    "input": {
      "description": "The arguments to the action."
    },
    "output": {
      "description": "The result of the action. For a step, an absent `output` marks an INTENDED action (pre-execution); a present one marks a COMPLETED action."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.end"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.error"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.idle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.resource"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "enum": [
              "GET",
              "POST",
              "PATCH",
              "DELETE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.message"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "enum": [
              "GET",
              "POST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.self"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "enum": [
              "GET",
              "POST",
              "PATCH",
              "DELETE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.model"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.credential"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "enum": [
              "GET",
              "POST",
              "PATCH",
              "DELETE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.exec"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.gate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step.unknown"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "verb": false
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "kind": {
              "const": "task.start"
            }
          }
        }
      },
      "then": {
        "properties": {
          "parent_task_id": false,
          "aag_version": false
        }
      }
    }
  ]
}
